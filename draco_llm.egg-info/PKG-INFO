## Position Encodings

```python
from draco.position.rope import RotaryPositionEmbedding
from draco.position.alibi import ALiBi

position_ids = torch.arange(32).unsqueeze(0)  # (1, 32)

# Standard RoPE
rope = RotaryPositionEmbedding(
    rope_theta=10000.0,
    max_position_embeddings=128,
    head_dim=64,
)
cos, sin = rope.forward(position_ids, head_dim=64)

# NTK-aware RoPE (for longer contexts)
ntk = RotaryPositionEmbedding(
    rope_theta=10000.0,
    max_position_embeddings=128,
    head_dim=64,
    rope_scaling={"type": "ntk", "factor": 4.0},
)
cos_ntk, sin_ntk = ntk.forward(position_ids, head_dim=64)

# YaRN RoPE
yarn = RotaryPositionEmbedding(
    rope_theta=10000.0,
    max_position_embeddings=128,
    head_dim=64,
    rope_scaling={"type": "yarn", "factor": 4.0},
)

# ALiBi (used by Falcon, BLOOM)
alibi = ALiBi(num_heads=8, max_position_embeddings=128)
bias, mask = alibi.forward(position_ids, head_dim=64)
```

