## Attention Backends

```python
from draco.attention.base import (
    MultiHeadAttention,
    GroupedQueryAttention,
    SlidingWindowAttention,
    create_attention_backend,
)

# Factory function
mha  = create_attention_backend(num_heads=8, num_kv_heads=8, head_dim=64, attn_type="MHA")
gqa  = create_attention_backend(num_heads=8, num_kv_heads=2, head_dim=64, attn_type="GQA")
mqa  = create_attention_backend(num_heads=8, num_kv_heads=1, head_dim=64, attn_type="MQA")
sw   = create_attention_backend(num_heads=8, num_kv_heads=8, head_dim=64,
                                 attn_type="SLIDING_WINDOW", window_size=256)

# Forward pass
q = torch.randn(2, 8, 32, 64)   # (batch, heads, seq_len, head_dim)
k = torch.randn(2, 2, 32, 64)   # (batch, kv_heads, seq_len, head_dim)
v = torch.randn(2, 2, 32, 64)
out = gqa.forward(q, k, v)      # (2, 8, 32, 64)

print(f"Type:  {gqa.attention_type.value}")
print(f"Class: {type(gqa).__name__}")
```

