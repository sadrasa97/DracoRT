## Engine API

### LLM

```python
from draco import LLM, SamplingParams

# Load a model — auto-detects architecture from config.json
llm = LLM(
    model="meta-llama/Llama-3-8B",   # HF repo or local path
    tokenizer=None,                   # defaults to model path
    dtype="auto",                     # auto / float16 / bfloat16 / float32
    max_model_len=8192,
    gpu_memory_utilization=0.90,
    tensor_parallel_size=1,
    quantization=None,                # gptq / awq / fp8 / bitsandbytes
    trust_remote_code=False,
    seed=42,
)

# Generate text
outputs = llm.generate(
    prompts=["Hello, how are you?", "Tell me a joke"],
    sampling_params=SamplingParams(temperature=0.7, max_tokens=256),
)

for output in outputs:
    print(f"Prompt: {output.prompt!r}")
    print(f"Text:   {output.outputs[0].text!r}")
    print(f"Tokens: {len(output.outputs[0].token_ids)}")
```

### SamplingParams

```python
from draco.engine.sampling import SamplingParams

# Default (greedy)
params = SamplingParams()

# Creative writing
params = SamplingParams(
    temperature=0.9,
    top_p=0.95,
    top_k=50,
    max_tokens=512,
    repetition_penalty=1.1,
)

# Precise / factual
params = SamplingParams(
    temperature=0.3,
    top_p=0.8,
    max_tokens=128,
)

# With stop conditions
params = SamplingParams(
    max_tokens=256,
    stop=["\n\n", "END"],
    stop_token_ids=[0, 2],
)

# Validate
params = SamplingParams(temperature=-1)  # raises ValueError
```

**All parameters:**

| Parameter | Default | Description |
|-----------|---------|-------------|
| `temperature` | 1.0 | Sampling temperature (0 = greedy) |
| `top_p` | 1.0 | Nucleus sampling threshold |
| `top_k` | -1 | Top-k sampling (-1 = disabled) |
| `min_p` | 0.0 | Minimum probability threshold |
| `max_tokens` | 16 | Maximum tokens to generate |
| `min_tokens` | 0 | Minimum tokens to generate |
| `stop` | None | Stop strings |
| `stop_token_ids` | None | Stop token IDs |
| `repetition_penalty` | 1.0 | Repetition penalty |
| `frequency_penalty` | 0.0 | Frequency penalty |
| `presence_penalty` | 0.0 | Presence penalty |
| `seed` | None | Random seed |
| `ignore_eos` | False | Ignore end-of-sequence token |
| `n` | 1 | Number of completions |

---

## Model Registry

The registry maps HuggingFace architecture strings to Draco adapter implementations.

```python
from draco.models.registry import MODEL_REGISTRY

# List all registered architectures
archs = MODEL_REGISTRY.list_architectures()
print(f"Registered: {len(archs)} architectures")
# ['FalconForCausalLM', 'GemmaForCausalLM', 'GPT2LMHeadModel', ...]

# Look up an adapter
adapter_cls = MODEL_REGISTRY.get("LlamaForCausalLM")

# Resolve by architecture or model_type
adapter_cls = MODEL_REGISTRY.resolve(
    architecture="LlamaForCausalLM",
    model_type="llama",
)

# Check if an architecture is registered
assert "LlamaForCausalLM" in MODEL_REGISTRY

# Get metadata
meta = MODEL_REGISTRY.get_metadata("LlamaForCausalLM")
print(meta)
# {'model_type': 'llama', 'implementation': 'LlamaAdapter', ...}

# Print full summary
print(MODEL_REGISTRY.summary())
```

### Registering a new adapter

```python
from draco.models.adapter import ModelAdapter
from draco.models.registry import MODEL_REGISTRY
from draco.models.config import ModelConfig

class MyModelAdapter(ModelAdapter):
    @property
    def architecture_name(self) -> str:
        return "MyModelForCausalLM"

    @property
    def model_type(self) -> str:
        return "my_model"

    def build_model(self):
        # Build and return the nn.Module
        ...

    def embed(self, input_ids):
        ...

    def attention(self, layer_idx, hidden_states, position_ids, kv_cache=None, attn_mask=None):
        ...

    def mlp(self, layer_idx, hidden_states):
        ...

    def norm(self, hidden_states):
        ...

    def lm_head(self, hidden_states):
        ...

    def rotary_embedding(self, position_ids, head_dim):
        ...

    def prepare_inputs(self, input_ids, position_ids, kv_cache=None, **kwargs):
        ...

    def load_weights(self, model, weight_path, **kwargs):
        ...

    def get_weight_map(self):
        ...

    # Dimension queries
    def get_num_layers(self): ...
    def get_hidden_size(self): ...
    def get_num_heads(self): ...
    def get_num_kv_heads(self): ...
    def get_head_dim(self): ...
    def get_vocab_size(self): ...

# Register
MODEL_REGISTRY.register(
    architecture="MyModelForCausalLM",
    implementation=MyModelAdapter,
    model_type="my_model",
    aliases=["MyModelV2ForCausalLM"],  # optional aliases
    status="active",
)
```

### Using the decorator form

```python
@MODEL_REGISTRY.register_decorator("MyModelForCausalLM", model_type="my_model")
class MyModelAdapter(ModelAdapter):
    ...
```

