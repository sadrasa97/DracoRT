## Quick Start

```python
from draco import LLM, SamplingParams

llm = LLM(
    model="meta-llama/Llama-3-8B",
    dtype="bfloat16",
    max_model_len=32768,
    gpu_memory_utilization=0.90,
)

sampling_params = SamplingParams(
    temperature=0.7,
    top_p=0.95,
    top_k=50,
    max_tokens=256,
)

outputs = llm.generate(
    ["Hello, how are you?"],
    sampling_params,
)

for output in outputs:
    print(output.outputs[0].text)
```

### Quantized models

```python
# Auto-detect from checkpoint metadata
llm = LLM(model="TheBloke/Llama-2-7B-Chat-GPTQ")

# Explicit quantization
llm = LLM(model="model-path", quantization="gptq")

# List supported quantization backends
from draco import QUANT_REGISTRY
print(QUANT_REGISTRY.list_methods())  # ['awq', 'bitsandbytes', 'fp8', 'gptq']
```

### Metrics

```python
metrics = llm.metrics()
print(f"TTFT:          {metrics.request.ttft_ms:.1f} ms")
print(f"ITL:           {metrics.request.itl_ms:.1f} ms")
print(f"TPOT:          {metrics.request.tpot_ms:.1f} ms")
print(f"Throughput:    {metrics.generation.tokens_per_second:.1f} tok/s")
print(f"GPU Memory:    {metrics.gpu.allocated_memory_gb:.2f} GB")
print(f"Speculative:   {metrics.speculative.acceptance_rate:.2%}")
print(f"Quantization:  {metrics.quantization.quantization_method}")
```

